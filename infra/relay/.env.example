# Copy to .env and fill in. .env is gitignored.

# Public DNS name pointing at this VPS. Caddy uses it to request a
# Let's Encrypt certificate.
RELAY_HOSTNAME=relay.example.com

# HMAC secret shared with the bamboo controller's session_secret.
# Generate with: openssl rand -base64 48
# Both the controller and the relay must use the SAME value, otherwise
# the relay will reject every CLIENT_HELLO.
BAMBOO_RELAY_SHARED_SECRET=change-me-to-controller-session-secret
