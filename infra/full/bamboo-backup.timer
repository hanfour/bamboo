[Unit]
Description=Run the bamboo Postgres backup nightly

[Timer]
# 03:30 UTC daily. Persistent=true so a run missed while the box was off
# fires on the next boot — backups are the one job you never want to
# silently skip. A small jitter avoids a thundering herd if the host runs
# other 03:30 jobs.
OnCalendar=*-*-* 03:30:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
