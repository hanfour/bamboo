# Caddy reverse-proxy for the single-VPS bamboo deployment.
#
# Two virtual hosts, both with auto-issued Let's Encrypt certs:
#
#   {$DOMAIN}        Web UI + controller HTTP/REST + OIDC routes
#   {$RELAY_DOMAIN}  Relay WebSocket only
#
# Hosting both on the same VPS is fine for first-user dogfood; a
# production deployment moves the relay to its own host (Vultr
# Tokyo / Hetzner Helsinki) so relay bandwidth doesn't compete with
# control-plane traffic.

{$DOMAIN} {
    # HSTS: after the first HTTPS visit, browsers refuse plain-HTTP to
    # this host for a year — closes the first-request MITM window on the
    # session cookie (audit H-2). Drop includeSubDomains if you host
    # unrelated services on sibling subdomains you don't want pinned.
    header Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # Controller endpoints — REST + OIDC + healthz + the client installer.
    @controller path /api/* /auth/* /healthz /install.sh
    handle @controller {
        reverse_proxy controller:8081
    }

    # gRPC for the bamboo CLI (peer watch, device desk). The controller
    # serves plaintext HTTP/2 on 8080 inside the compose network; Caddy
    # terminates TLS and speaks h2c to it. Streams stay open for hours, so
    # flushing is immediate. Authentication is the controller's own
    # (pre-auth key on Register, peer-session bearer afterwards).
    @grpc path /bamboo.v1.*
    handle @grpc {
        reverse_proxy h2c://controller:8080 {
            flush_interval -1
        }
    }

    # Everything else lands on the Web UI (Next.js standalone).
    handle {
        reverse_proxy web:3000
    }
}

{$RELAY_DOMAIN} {
    # Relay WebSocket. Caddy preserves the WS upgrade handshake by
    # default; no extra config needed.
    reverse_proxy relay:8443
}
