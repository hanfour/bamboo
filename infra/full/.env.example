# Copy to .env and fill in. .env is gitignored.

# Public DNS names. Both must point at this VPS's public IP.
DOMAIN=bamboo.yourdomain.com
RELAY_DOMAIN=relay.yourdomain.com

# Random 64-byte HMAC key used by the controller to sign session JWTs
# and OIDC state. Keep it secret to the controller.
# Generate with: openssl rand -base64 48
BAMBOO_SESSION_SECRET=change-me-openssl-rand-base64-48-generated-value-min-32-chars

# Dedicated HMAC key for relay tokens (audit C-1). The relay runs on
# more exposed infrastructure, so isolating its signing key means a
# relay-host compromise can't forge session JWTs. STRONGLY RECOMMENDED
# to set this to a DIFFERENT value than BAMBOO_SESSION_SECRET.
# If left unset, the stack falls back to BAMBOO_SESSION_SECRET (the old
# shared-secret behavior) so existing deployments keep working.
# Generate with: openssl rand -base64 48
BAMBOO_RELAY_SECRET=change-me-a-DIFFERENT-openssl-rand-base64-48-value-min-32

# Database passwords. Internal to the docker network only — clients
# never see these. Use hex (not base64) because both passwords are
# embedded in DATABASE_URL / CLICKHOUSE_URL; base64 output routinely
# contains '/' which breaks URL parsing on the controller side.
# Generate with: openssl rand -hex 24   (48 hex chars = 192 bits)
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me

# Optional: OIDC. Empty values disable that provider. Once you
# register OAuth clients in console.cloud.google.com / GitHub
# settings, set both ID and SECRET below. Redirect URIs:
#   https://${DOMAIN}/auth/google/callback
#   https://${DOMAIN}/auth/github/callback
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=
OIDC_GITHUB_CLIENT_ID=
OIDC_GITHUB_CLIENT_SECRET=

# Auth mode. Prod default is "true" — the REST /api/v1/* surface
# rejects unauthenticated requests instead of falling back to the
# X-Tenant-Slug dev path. Leave this commented out unless you have a
# specific reason to flip it (e.g. reproducing a dev-mode bug).
# BAMBOO_REQUIRE_AUTH=false

# BAMBOO_RELEASE_FEED_ENABLED=true       # Set false for air-gapped controllers
# BAMBOO_RELEASE_FEED_REPO=hanfour/bamboo
# BAMBOO_RELEASE_FEED_INTERVAL=1h        # Minimum 5m
