# Copy to .env and fill in. Loaded by `make dev`.
# These environment variables override values in config/example.yaml.

DATABASE_URL=postgres://bamboo:dev@localhost:5432/bamboo?sslmode=disable
REDIS_URL=redis://localhost:6379

# OIDC
OIDC_GOOGLE_CLIENT_ID=
OIDC_GOOGLE_CLIENT_SECRET=

OIDC_GITHUB_CLIENT_ID=
OIDC_GITHUB_CLIENT_SECRET=
